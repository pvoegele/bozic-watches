<section class="sw-sec">
  <div class="sw-wrap">
    <div class="sw-head">
      <h1 class="sw-h2">Suche</h1>
      {%- if search.performed -%}
        <span class="sw-label sw-label--dim">{{ search.results_count }} Treffer für „{{ search.terms | escape }}"</span>
      {%- endif -%}
    </div>

    <form action="{{ routes.search_url }}" method="get" class="sw-form" style="margin-bottom: 2.5rem;">
      <div class="sw-form-row" style="display: flex; gap: 0.6rem; margin-bottom: 0;">
        <label class="sw-skip" for="SearchInput">Suchbegriff</label>
        <input type="text" id="SearchInput" name="q" value="{{ search.terms | escape }}" placeholder="Marke, Modell, Referenz …">
        <button type="submit" class="sw-btn">Suchen</button>
      </div>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results_count > 0 -%}
          <div class="sw-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="sw-empty">
            <h2>Keine Treffer</h2>
            <p>Nicht gefunden, was Sie suchen? Hinterlegen Sie einen Suchauftrag — wir beschaffen Ihre Wunschuhr.</p>
            <a class="sw-btn sw-btn--red" href="/pages/kontakt">Suchauftrag anlegen</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Suche", "settings": [] }
{% endschema %}
