<section class="sw-sec">
  <div class="sw-wrap">
    <div class="sw-head">
      <h1 class="sw-h2">{{ page.title | default: 'Uhr verkaufen' }}</h1>
      <span class="sw-label sw-label--red">Bewertung in 24 h</span>
    </div>

    {%- if page.content != blank -%}
      <div class="sw-rte" style="margin-bottom: 2.5rem;">{{ page.content }}</div>
    {%- endif -%}

    <div class="sw-form">
      {%- form 'contact' -%}
        {%- if form.posted_successfully? -%}
          <p class="sw-form-ok">Danke — Ihre Anfrage ist eingegangen. Sie erhalten unsere Bewertung innerhalb von 24 Stunden.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="sw-form-err">Bitte prüfen Sie Ihre Angaben — {{ form.errors | size }} Feld(er) fehlen oder sind ungültig.</div>
        {%- endif -%}

        <div class="sw-form-row">
          <label for="AnkaufMarke">Marke &amp; Modell</label>
          <input type="text" id="AnkaufMarke" name="contact[Marke und Modell]" required placeholder="z. B. Rolex Submariner 126610LN">
        </div>
        <div class="sw-form-row">
          <label for="AnkaufZustand">Zustand</label>
          <select id="AnkaufZustand" name="contact[Zustand]">
            <option>Neuwertig</option>
            <option>Sehr gut</option>
            <option>Gebrauchsspuren</option>
            <option>Servicebedürftig</option>
          </select>
        </div>
        <div class="sw-form-row">
          <label for="AnkaufUmfang">Lieferumfang</label>
          <select id="AnkaufUmfang" name="contact[Lieferumfang]">
            <option>Fullset (Box &amp; Papiere)</option>
            <option>Nur Box</option>
            <option>Nur Papiere</option>
            <option>Uhr solo</option>
          </select>
        </div>
        <div class="sw-form-row">
          <label for="AnkaufEmail">E-Mail</label>
          <input type="email" id="AnkaufEmail" name="contact[email]" required autocomplete="email">
        </div>
        <div class="sw-form-row">
          <label for="AnkaufTel">Telefon / WhatsApp (optional)</label>
          <input type="tel" id="AnkaufTel" name="contact[Telefon]" autocomplete="tel">
        </div>
        <div class="sw-form-row">
          <label for="AnkaufNotiz">Anmerkungen</label>
          <textarea id="AnkaufNotiz" name="contact[body]" placeholder="Kaufjahr, Servicehistorie, Besonderheiten …"></textarea>
          <p class="sw-form-hint">Fotos senden Sie uns am einfachsten nach dem Erstkontakt per WhatsApp oder E-Mail zu.</p>
        </div>
        <button type="submit" class="sw-btn sw-btn--red">Kostenlose Bewertung anfordern</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Ankauf-Formular", "settings": [], "presets": [ { "name": "Ankauf-Formular" } ] }
{% endschema %}
