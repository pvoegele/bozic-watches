<section class="sw-sec">
  <div class="sw-wrap">
    <div class="sw-head">
      <h2 class="sw-h2">{{ section.settings.title }}</h2>
      {%- if section.settings.collection != blank -%}
        <a class="sw-label sw-label--red" href="{{ section.settings.collection.url }}" style="text-decoration: none;">Alle ansehen →</a>
      {%- endif -%}
    </div>

    {%- assign col = section.settings.collection -%}
    {%- if col != blank and col.products.size > 0 -%}
      <div class="sw-grid">
        {%- for product in col.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="sw-empty">
        <h2>Noch keine Uhren online</h2>
        <p>Wähle im Theme-Editor eine Kollektion für diese Sektion aus — die Neuzugänge erscheinen dann hier im Raster.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Uhren-Raster",
  "settings": [
    { "type": "text", "id": "title", "label": "Überschrift", "default": "Neuzugänge" },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "limit", "label": "Anzahl", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "presets": [ { "name": "Uhren-Raster" } ]
}
{% endschema %}
