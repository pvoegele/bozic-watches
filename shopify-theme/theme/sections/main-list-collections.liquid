<section class="sw-sec">
  <div class="sw-wrap">
    <div class="sw-head">
      <h1 class="sw-h2">Kollektionen</h1>
    </div>
    <div class="sw-grid">
      {%- for collection in collections -%}
        <a class="sw-card" href="{{ collection.url }}">
          <div class="sw-card-media">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" loading="lazy" width="600" height="600">
            {%- else -%}
              {% render 'swiss-disc' %}
            {%- endif -%}
          </div>
          <span class="sw-card-title">{{ collection.title }}</span>
          <span class="sw-card-price"><span class="sw-dim">{{ collection.products_count }} Uhren</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Kollektionsliste", "settings": [] }
{% endschema %}
