{% comment %}
  BOZIC Watches – Konzept-Seite (Schweizer Typografie)
  Generiert aus shopify-theme/preview/konzept-preview.html – Änderungen
  dort vornehmen und build-liquid.py erneut ausführen.
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700;800&display=swap">
<style>
/* ==========================================================================
   BOZIC Watches — Konzept · Schweizer Typografie
   Vorschau der Shopify-Section sections/konzept.liquid
   ========================================================================== */

.bz {
  --paper: #FCFCFA;      /* kuehles Papierweiss */
  --ink: #111110;        /* Tusche */
  --ink-soft: #57544D;   /* Sekundaertext */
  --red: #E30613;        /* Schweizer Signalrot: Flaechen, grosse Marken */
  --red-text: #D40010;   /* Rot fuer kleine Typo (Kontrast) */
  --hairline: #DBD8D0;
  --rule: #111110;

  font-family: "Hanken Grotesk", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-weight: 400;
  background: var(--paper);
  color: var(--ink);
  line-height: 1.6;
  margin: 0;
  font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
}

.bz *, .bz *::before, .bz *::after { box-sizing: border-box; }
.bz ::selection { background: var(--red); color: #FFFFFF; }
.bz a { color: inherit; }
.bz :focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }

.bz-wrap { max-width: 80rem; margin: 0 auto; padding: 0 1.25rem; }
@media (min-width: 1024px) { .bz-wrap { padding: 0 3rem; } }

/* ---------- Typografie ---------- */

.bz h1, .bz h2, .bz h3, .bz h4 { margin: 0; }

.bz-h1 {
  font-size: clamp(2.7rem, 9.5vw, 7.25rem);
  font-weight: 800;
  letter-spacing: -0.035em;
  line-height: 0.98;
  text-wrap: balance;
}
.bz-h1 .bz-rot { color: var(--red); }

.bz-h2 {
  font-size: clamp(2rem, 4.4vw, 3.4rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.02;
  text-wrap: balance;
}

.bz-lead {
  font-size: 1.0625rem;
  line-height: 1.6;
  color: var(--ink-soft);
  max-width: 42rem;
  margin: 0;
}

.bz-label {
  font-size: 0.6563rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
}
.bz-label--red { color: var(--red-text); }
.bz-label--dim { color: var(--ink-soft); }

.bz-num { font-variant-numeric: tabular-nums; }

/* ---------- Kapitelkopf: Linie, rote Ziffer, Titel, Lead ---------- */

.bz-sec { padding: 5.5rem 0 6.5rem; }
@media (max-width: 720px) { .bz-sec { padding: 3.5rem 0 4.5rem; } }

.bz-chap {
  border-top: 2px solid var(--rule);
  padding-top: 1.1rem;
  margin-bottom: 3.25rem;
  display: grid;
  grid-template-columns: 5.5rem 1fr;
  gap: 1rem 2rem;
}
@media (max-width: 860px) { .bz-chap { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; } }
.bz-chap .bz-chapno {
  font-size: 2rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--red);
  line-height: 1;
  padding-top: 0.35rem;
}
.bz-chap .bz-lead { margin-top: 1.1rem; }

/* ---------- Hero ---------- */

.bz-hero { padding: 2.25rem 0 5rem; }

.bz-masthead {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem 2.5rem;
  justify-content: space-between;
  border-top: 2px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  padding: 0.7rem 0;
  margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
}

.bz-hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  gap: 3rem 4rem;
  align-items: center;
}
@media (max-width: 900px) { .bz-hero-grid { grid-template-columns: minmax(0, 1fr); } }

.bz-hero .bz-lead {
  margin-top: 2rem;
  font-size: clamp(1.0625rem, 1.7vw, 1.25rem);
  max-width: 36rem;
}

/* Plakatelement: rote Scheibe mit Zeigern 10:08 — Platzhalter fuer das Video */
.bz-mark { display: grid; place-items: center; }
.bz-mark-media { position: relative; width: min(24rem, 78vw); aspect-ratio: 1; }
.bz-mark svg { width: 100%; height: 100%; display: block; }
.bz-mark figcaption, .bz-figcap {
  margin-top: 0.8rem;
  padding-top: 0.5rem;
  border-top: 1px solid var(--rule);
  font-size: 0.6563rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--ink-soft);
  width: 100%;
}
.bz-mark figcaption b, .bz-figcap b { color: var(--red-text); font-weight: 700; }

.bz-mark video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  clip-path: circle(49.2%);
  filter: grayscale(1) contrast(1.06);
  opacity: 0;
  transition: opacity 0.5s ease;
}
.bz-mark video.bz-playing { opacity: 1; }

/* Einmaliger Moment: die Scheibe setzt beim Laden ein */
@keyframes bz-set { from { transform: scale(0.985); opacity: 0; } to { transform: none; opacity: 1; } }
.bz-js .bz-mark-media { animation: bz-set 0.7s cubic-bezier(0.2, 1, 0.3, 1) both; }

/* Kapitelindex */
.bz-index {
  margin-top: clamp(3rem, 7vw, 5rem);
  border-top: 2px solid var(--rule);
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
}
@media (max-width: 980px) { .bz-index { grid-template-columns: 1fr 1fr; } }
@media (max-width: 540px) { .bz-index { grid-template-columns: 1fr; } }
.bz-index a {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  padding: 0.85rem 1rem 0.85rem 0;
  border-bottom: 1px solid var(--hairline);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.9063rem;
  letter-spacing: -0.005em;
}
.bz-index a span { color: var(--red); font-weight: 800; font-size: 0.75rem; }
.bz-index a:hover { color: var(--red-text); }

/* ---------- 01 Standbeine ---------- */

.bz-pillars {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
}
@media (max-width: 860px) { .bz-pillars { grid-template-columns: minmax(0, 1fr); } }
.bz-pillar { padding: 1.75rem 2rem 1.75rem 0; }
@media (min-width: 861px) {
  .bz-pillar + .bz-pillar { border-left: 1px solid var(--hairline); padding-left: 2rem; }
}
@media (max-width: 860px) {
  .bz-pillar + .bz-pillar { border-top: 1px solid var(--hairline); }
}
.bz-pillar h3 {
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  margin-bottom: 0.7rem;
}
.bz-pillar p { margin: 0 0 1.1rem; font-size: 0.9063rem; color: var(--ink-soft); }
.bz-pillar .bz-label { display: block; }

/* Verkaufswege: Preisskala als Masslinie */
.bz-scale { margin-top: 4rem; }
.bz-scale-head { display: flex; justify-content: space-between; align-items: baseline; gap: 2rem; margin-bottom: 1.4rem; }
.bz-scale-bar {
  position: relative;
  height: 2px;
  background: var(--rule);
}
.bz-scale-bar i {
  position: absolute;
  top: 50%;
  width: 2px;
  height: 1rem;
  transform: translateY(-50%);
  background: var(--rule);
}
.bz-scale-bar i:nth-child(1) { left: 33.333%; }
.bz-scale-bar i:nth-child(2) { left: 66.666%; }
.bz-modes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; margin-top: 1.5rem; }
@media (max-width: 860px) {
  .bz-scale-bar { display: none; }
  .bz-modes { grid-template-columns: 1fr; gap: 0; }
  .bz-modes > div { border-top: 1px solid var(--hairline); padding: 1.4rem 0; }
}
.bz-mode .bz-price {
  display: block;
  font-size: 1.75rem;
  font-weight: 800;
  letter-spacing: -0.025em;
}
.bz-mode h3 { font-size: 0.9688rem; font-weight: 700; margin: 0.6rem 0 0.4rem; }
.bz-mode h3::before { content: ''; display: inline-block; width: 0.55em; height: 0.55em; background: var(--red); margin-right: 0.55em; }
.bz-mode p { margin: 0; font-size: 0.875rem; color: var(--ink-soft); }

.bz-note { margin-top: 2.5rem; font-size: 0.8125rem; color: var(--ink-soft); max-width: 46rem; }
.bz-note code {
  font-family: inherit;
  font-weight: 700;
  color: var(--red-text);
}

/* ---------- 02 Architektur: Liniendiagramm ---------- */

.bz-arch { border: 1px solid var(--rule); }
.bz-arch-row { display: grid; }
.bz-arch-row--2 { grid-template-columns: 1fr 1fr; }
.bz-arch-row--3 { grid-template-columns: repeat(3, 1fr); }
@media (max-width: 760px) { .bz-arch-row--2, .bz-arch-row--3 { grid-template-columns: 1fr; } }
.bz-cell {
  padding: 1.4rem 1.6rem 1.5rem;
  border-bottom: 1px solid var(--rule);
  position: relative;
}
.bz-arch-row--2 .bz-cell + .bz-cell,
.bz-arch-row--3 .bz-cell + .bz-cell { border-left: 1px solid var(--rule); }
@media (max-width: 760px) {
  .bz-arch-row--2 .bz-cell + .bz-cell,
  .bz-arch-row--3 .bz-cell + .bz-cell { border-left: none; }
}
.bz-arch-row:last-child .bz-cell { border-bottom: none; }
.bz-cell h3 {
  font-size: 1.125rem;
  font-weight: 800;
  letter-spacing: -0.015em;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 0.4rem;
}
.bz-cell p { margin: 0; font-size: 0.8438rem; color: var(--ink-soft); }
.bz-cell--hub {
  border-top: 2px solid var(--rule);
  border-bottom: 2px solid var(--rule);
  padding-top: 1.6rem;
  padding-bottom: 1.7rem;
}
.bz-cell--hub h3 { font-size: 1.375rem; }

.bz-arch-why {
  margin: 2.75rem 0 0;
  padding: 0;
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
}
@media (max-width: 860px) { .bz-arch-why { grid-template-columns: 1fr; gap: 1.25rem; } }
.bz-arch-why li {
  border-top: 2px solid var(--red);
  padding-top: 0.8rem;
  font-size: 0.875rem;
  color: var(--ink-soft);
}
.bz-arch-why strong { display: block; color: var(--ink); font-weight: 700; }

/* ---------- 03 Verwaltung: Taktleiste + Register ---------- */

.bz-rail {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  list-style: none;
  margin: 0 0 3.5rem;
  padding: 0;
  border-top: 2px solid var(--rule);
  counter-reset: step;
}
@media (max-width: 980px) { .bz-rail { grid-template-columns: repeat(4, 1fr); } }
@media (max-width: 560px) { .bz-rail { grid-template-columns: repeat(2, 1fr); } }
.bz-rail li {
  counter-increment: step;
  padding: 0.8rem 0.9rem 1rem 0;
  border-bottom: 1px solid var(--hairline);
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: -0.005em;
}
.bz-rail li::before {
  content: counter(step, decimal-leading-zero);
  display: block;
  font-size: 0.6563rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: var(--red);
  margin-bottom: 0.3rem;
}
.bz-rail li[data-live] { color: var(--red-text); }
.bz-rail li[data-live]::after {
  content: 'im Shop sichtbar';
  display: block;
  margin-top: 0.15rem;
  font-size: 0.5938rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--ink-soft);
}
/* Der eine Motion-Moment: die Taktleiste tickt einmal durch */
.bz-js .bz-rail[data-animate] li { opacity: 0; transition: opacity 0.3s steps(1, end); }
.bz-js .bz-rail[data-animate].bz-in li { opacity: 1; }

.bz-admin { display: grid; grid-template-columns: 1.15fr 1fr 1fr; gap: 3rem; }
@media (max-width: 960px) { .bz-admin { grid-template-columns: minmax(0, 1fr); gap: 2rem; } }
.bz-admin h3 {
  font-size: 1.0625rem;
  font-weight: 800;
  letter-spacing: -0.01em;
  border-bottom: 2px solid var(--rule);
  padding-bottom: 0.6rem;
  margin-bottom: 0.9rem;
}
.bz-admin p { margin: 0 0 0.9rem; font-size: 0.8438rem; color: var(--ink-soft); }

.bz-fields, .bz-list { list-style: none; margin: 0; padding: 0; }
.bz-fields li {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--hairline);
  font-size: 0.8125rem;
  font-weight: 600;
}
.bz-fields li:last-child, .bz-list li:last-child { border-bottom: none; }
.bz-fields .bz-tag {
  font-size: 0.5938rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--red-text);
  white-space: nowrap;
}
.bz-fields .bz-tag--int { color: var(--ink-soft); }
.bz-list li { padding: 0.55rem 0; border-bottom: 1px solid var(--hairline); font-size: 0.8438rem; color: var(--ink-soft); }
.bz-list strong { color: var(--ink); font-weight: 700; }

/* ---------- 04 Abrechnung ---------- */

.bz-billing { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 2.5rem; align-items: start; }
@media (max-width: 960px) { .bz-billing { grid-template-columns: minmax(0, 1fr); } }

/* Die eine Schwarzflaeche: Merktafel §25a */
.bz-board {
  background: var(--ink);
  color: var(--paper);
  padding: 2.4rem 2.2rem 2.5rem;
}
.bz-board .bz-law {
  font-size: clamp(2.4rem, 4.5vw, 3.4rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1;
  color: #FFFFFF;
}
.bz-board .bz-law small { display: block; font-size: 0.375em; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #FF6B74; margin-top: 0.5rem; }
.bz-board p { margin: 1.1rem 0 0; font-size: 0.875rem; color: rgba(252, 252, 250, 0.78); }
.bz-board strong { color: #FFFFFF; }

.bz-tablescroll { position: relative; min-width: 0; }
.bz-tablecase { overflow-x: auto; scrollbar-width: thin; scrollbar-color: var(--ink-soft) var(--paper); border-top: 2px solid var(--rule); }
@media (max-width: 760px) {
  .bz-tablescroll::after {
    content: '';
    position: absolute;
    top: 2px; right: 0; bottom: 0;
    width: 3rem;
    background: linear-gradient(90deg, rgba(252, 252, 250, 0), rgba(252, 252, 250, 0.95));
    pointer-events: none;
  }
}
.bz-table { width: 100%; border-collapse: collapse; font-size: 0.8438rem; min-width: 30rem; }
.bz-table caption { text-align: left; padding: 0.7rem 0 0.9rem; font-size: 0.6563rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--red-text); }
.bz-table th {
  text-align: left;
  font-size: 0.5938rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--ink-soft);
  padding: 0.55rem 1.25rem 0.55rem 0;
  border-bottom: 1px solid var(--rule);
  white-space: nowrap;
}
.bz-table td { padding: 0.7rem 1.25rem 0.7rem 0; border-bottom: 1px solid var(--hairline); vertical-align: top; }
.bz-table tr:last-child td { border-bottom: none; }
.bz-table .bz-dim { color: var(--ink-soft); }
.bz-table .bz-right { text-align: right; white-space: nowrap; font-weight: 600; padding-right: 0; }
.bz-table tr.bz-sum td { border-top: 2px solid var(--rule); font-weight: 800; color: var(--red-text); }

.bz-flow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.6rem;
  margin-top: 2.5rem;
  font-size: 0.8125rem;
  font-weight: 600;
}
.bz-flow .bz-step { border: 1px solid var(--rule); padding: 0.45rem 0.8rem; }
.bz-flow svg { width: 0.9rem; height: 0.9rem; color: var(--red); flex-shrink: 0; }

/* ---------- 05 Marketing ---------- */

.bz-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2.75rem; }
.bz-chips span { border: 1px solid var(--rule); padding: 0.4rem 0.8rem; font-size: 0.7188rem; font-weight: 600; }
.bz-chips span b { color: var(--red-text); font-weight: 700; }

.bz-channels { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
@media (max-width: 900px) { .bz-channels { grid-template-columns: minmax(0, 1fr); } }
.bz-channel-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
  flex-wrap: wrap;
  border-bottom: 2px solid var(--rule);
  padding-bottom: 0.7rem;
}
.bz-channel-head h3 { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; }
.bz-channel-head .bz-budget { font-size: 0.75rem; font-weight: 700; color: var(--red-text); white-space: nowrap; }
.bz-channel table { width: 100%; border-collapse: collapse; font-size: 0.8438rem; }
.bz-channel td { padding: 0.6rem 0; border-bottom: 1px solid var(--hairline); }
.bz-channel tr:last-child td { border-bottom: none; }
.bz-channel td em { font-style: normal; color: var(--ink-soft); }
.bz-channel td:last-child { text-align: right; font-weight: 600; white-space: nowrap; color: var(--ink); }
.bz-channel-note { margin: 1.1rem 0 0; font-size: 0.8125rem; color: var(--ink-soft); }
.bz-channel-note strong { color: var(--ink); font-weight: 700; }

.bz-leadflow {
  margin-top: 3rem;
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  padding: 1.1rem 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.7rem;
  font-size: 0.8438rem;
  font-weight: 600;
}
.bz-leadflow svg { width: 0.9rem; height: 0.9rem; color: var(--red); flex-shrink: 0; }
.bz-leadflow .bz-sla {
  margin-left: auto;
  background: var(--red);
  color: #FFFFFF;
  font-size: 0.6563rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  padding: 0.45rem 0.8rem;
  white-space: nowrap;
}
@media (max-width: 720px) { .bz-leadflow .bz-sla { margin-left: 0; } }

/* ---------- 06 Roadmap ---------- */

.bz-phase {
  display: grid;
  grid-template-columns: 11rem 1fr;
  gap: 1rem 3rem;
  border-top: 1px solid var(--rule);
  padding: 1.75rem 0 2.5rem;
}
@media (max-width: 760px) { .bz-phase { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; } }
.bz-phase:last-of-type { border-bottom: 1px solid var(--rule); }
.bz-phase .bz-when {
  font-size: 0.6875rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--red-text);
  padding-top: 0.5rem;
}
.bz-phase h3 { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.3rem; }
.bz-phase .bz-goal { margin: 0 0 1.1rem; font-size: 0.875rem; color: var(--ink-soft); }
.bz-phase ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.45rem 2.75rem;
  max-width: 52rem;
}
@media (max-width: 820px) { .bz-phase ul { grid-template-columns: 1fr; } }
.bz-phase li { position: relative; padding-left: 1.1rem; font-size: 0.8438rem; font-weight: 500; }
.bz-phase li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 0.45rem; height: 2px; background: var(--red); }

/* ---------- 07 Kosten ---------- */

.bz-costwrap { max-width: 44rem; }

/* ---------- 08 Entscheidungen: die Rotflaeche ---------- */

.bz-final { background: var(--red); color: #FFFFFF; padding: 5.5rem 0 4.5rem; }
@media (max-width: 720px) { .bz-final { padding: 3.5rem 0; } }
.bz-final .bz-chap { border-top-color: #FFFFFF; }
.bz-final .bz-chapno { color: #FFFFFF; }
.bz-final .bz-lead { color: #FFFFFF; }

.bz-decisions {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 4rem;
  counter-reset: dec;
}
@media (max-width: 860px) { .bz-decisions { grid-template-columns: minmax(0, 1fr); } }
.bz-decisions li {
  counter-increment: dec;
  display: grid;
  grid-template-columns: 2.2rem 1fr;
  gap: 1rem;
  padding: 1.1rem 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.35);
}
.bz-decisions li::before {
  content: counter(dec, decimal-leading-zero);
  font-size: 0.8125rem;
  font-weight: 800;
  padding-top: 0.2rem;
}
.bz-decisions h3 { font-size: 1rem; font-weight: 800; letter-spacing: -0.01em; margin-bottom: 0.2rem; }
.bz-decisions p { margin: 0; font-size: 0.8125rem; color: #FFFFFF; font-weight: 400; }
.bz-decisions p strong { color: #FFFFFF; font-weight: 700; }

.bz-cta { margin-top: 3.5rem; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: end; }
