<footer class="sw-footer">
  <div class="sw-wrap">
    <div class="sw-footer-grid">
      <span class="sw-logo">{{ shop.name | default: 'BOZIC Watches' }}<b>.</b></span>
      <nav class="sw-nav" aria-label="Fußnavigation">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    </div>
    <p class="sw-footer-note">
      <span>{{ section.settings.note }}</span>
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "Fußzeile",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menü (z. B. Rechtliches)", "default": "footer" },
    { "type": "text", "id": "note", "label": "Hinweiszeile", "default": "Unabhängiger Fachhändler. Kein autorisierter Händler der genannten Marken." }
  ]
}
{% endschema %}
