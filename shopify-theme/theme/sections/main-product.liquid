{%- liquid
  assign status = product.metafields.custom.availability_status.value | default: 'available'
  unless product.available
    assign status = 'sold'
  endunless
  assign sales_mode = product.metafields.custom.sales_mode.value | default: 'checkout'
  assign show_price = true
  if product.metafields.custom.show_price.value == false or sales_mode == 'auf_anfrage'
    assign show_price = false
  endif
  assign brand = product.metafields.custom.brand.value | default: product.vendor
  assign reference = product.metafields.custom.reference.value
  assign inquiry_url = section.settings.inquiry_page | default: '/pages/kontakt'
-%}
<section class="sw-sec">
  <div class="sw-wrap">
    <div class="sw-product">

      <div class="sw-gallery-col">
        <div class="sw-gallery">
          {%- if product.featured_media -%}
            <img
              src="{{ product.featured_media | image_url: width: 1200 }}"
              srcset="{{ product.featured_media | image_url: width: 800 }} 800w, {{ product.featured_media | image_url: width: 1200 }} 1200w, {{ product.featured_media | image_url: width: 1600 }} 1600w"
              sizes="(max-width: 960px) 92vw, 55vw"
              alt="{{ product.featured_media.alt | default: product.title | escape }}"
              width="{{ product.featured_media.width }}"
              height="{{ product.featured_media.height }}">
          {%- else -%}
            <div class="sw-gallery-placeholder">{% render 'swiss-disc' %}</div>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="sw-gallery-thumbs" style="margin-top: 1px;">
            {%- for media in product.media offset: 1 limit: 4 -%}
              <img
                src="{{ media | image_url: width: 400 }}"
                alt="{{ media.alt | default: product.title | escape }}"
                loading="lazy"
                width="{{ media.width | default: 400 }}"
                height="{{ media.height | default: 400 }}">
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="sw-pinfo">
        {%- if brand != blank -%}<span class="sw-label sw-label--red">{{ brand }}</span>{%- endif -%}
        <h1>{{ product.title }}</h1>
        {%- if reference != blank -%}
          <p class="sw-ref">Referenz {{ reference }}</p>
        {%- endif -%}

        <div class="sw-price-row">
          {%- if status == 'sold' -%}
            <span class="sw-price sw-price--request">Verkauft</span>
            <span class="sw-label sw-label--dim">Referenzstück — nicht mehr verfügbar</span>
          {%- elsif show_price -%}
            <span class="sw-price">{{ product.price | money }}</span>
            {%- if status == 'reserved' -%}
              <span class="sw-label sw-label--red">Reserviert</span>
            {%- endif -%}
          {%- else -%}
            <span class="sw-price sw-price--request">Preis auf Anfrage</span>
          {%- endif -%}
        </div>

        <div class="sw-buy">
          {%- if status == 'available' -%}
            {%- if sales_mode == 'checkout' or sales_mode == 'inquiry' -%}
              {%- form 'product', product -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="sw-btn sw-btn--red">In den Warenkorb</button>
              {%- endform -%}
            {%- endif -%}
            {%- if sales_mode == 'inquiry' or sales_mode == 'auf_anfrage' -%}
              <a class="sw-btn sw-btn--ghost" href="{{ inquiry_url }}?uhr={{ product.handle }}">Beratung anfragen</a>
            {%- endif -%}
            {%- if section.settings.whatsapp != blank -%}
              <a class="sw-btn sw-btn--ghost" href="https://wa.me/{{ section.settings.whatsapp }}?text={{ product.title | url_encode }}" target="_blank" rel="noopener">WhatsApp</a>
            {%- endif -%}
          {%- elsif status == 'reserved' -%}
            <a class="sw-btn sw-btn--ghost" href="{{ inquiry_url }}?uhr={{ product.handle }}">Auf die Warteliste</a>
          {%- else -%}
            <a class="sw-btn sw-btn--ghost" href="{{ inquiry_url }}">Ähnliche Uhr anfragen</a>
          {%- endif -%}
        </div>

        <table class="sw-specs">
          <caption>Spezifikation</caption>
          <tbody>
            {%- if brand != blank -%}<tr><th scope="row">Marke</th><td>{{ brand }}</td></tr>{%- endif -%}
            {%- if product.metafields.custom.model.value != blank -%}<tr><th scope="row">Modell</th><td>{{ product.metafields.custom.model.value }}</td></tr>{%- endif -%}
            {%- if reference != blank -%}<tr><th scope="row">Referenz</th><td>{{ reference }}</td></tr>{%- endif -%}
            {%- if product.metafields.custom.year.value != blank -%}<tr><th scope="row">Jahr</th><td>{{ product.metafields.custom.year.value }}</td></tr>{%- endif -%}
            {%- if product.metafields.custom.case_size_mm.value != blank -%}<tr><th scope="row">Gehäuse</th><td>{{ product.metafields.custom.case_size_mm.value }} mm</td></tr>{%- endif -%}
            {%- if product.metafields.custom.material.value != blank -%}<tr><th scope="row">Material</th><td>{{ product.metafields.custom.material.value }}</td></tr>{%- endif -%}
            {%- if product.metafields.custom.movement.value != blank -%}<tr><th scope="row">Werk</th><td>{{ product.metafields.custom.movement.value }}</td></tr>{%- endif -%}
            {%- if product.metafields.custom.condition.value != blank -%}<tr><th scope="row">Zustand</th><td>{{ product.metafields.custom.condition.value }}</td></tr>{%- endif -%}
            {%- if product.metafields.custom.scope_of_delivery.value != blank -%}<tr><th scope="row">Lieferumfang</th><td>{{ product.metafields.custom.scope_of_delivery.value }}</td></tr>{%- endif -%}
          </tbody>
        </table>

        {%- if product.description != blank -%}
          <div class="sw-desc">{{ product.description }}</div>
        {%- endif -%}

        <p class="sw-trust">
          <span><b>·</b> Echtheit geprüft</span>
          <span><b>·</b> Versicherter Versand</span>
          <span><b>·</b> Ab 3.000 € Überweisung möglich</span>
        </p>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produkt (Uhr)",
  "settings": [
    { "type": "url", "id": "inquiry_page", "label": "Anfrage-/Kontaktseite" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp-Nummer (nur Ziffern, mit Ländercode)", "info": "z. B. 4915112345678 — leer lassen, um den Button auszublenden" }
  ]
}
{% endschema %}
