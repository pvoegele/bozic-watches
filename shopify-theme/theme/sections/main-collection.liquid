<section class="sw-sec">
  <div class="sw-wrap">
    <div class="sw-head">
      <h1 class="sw-h2">{{ collection.title }}</h1>
      <span class="sw-label sw-label--dim">{{ collection.products_count }} Uhren</span>
    </div>

    {%- if collection.description != blank -%}
      <div class="sw-rte" style="margin-bottom: 2rem;">{{ collection.description }}</div>
    {%- endif -%}

    {%- paginate collection.products by 24 -%}
      <div class="sw-toolbar">
        <span class="sw-label sw-label--dim">Sortierung</span>
        <form method="get">
          <label class="sw-skip" for="SortBy">Sortieren nach</label>
          <select id="SortBy" name="sort_by" onchange="this.form.submit()">
            {%- assign current = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == current %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </form>
      </div>

      {%- if collection.products.size > 0 -%}
        <div class="sw-grid">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="sw-empty">
          <h2>Zurzeit keine Uhren in dieser Auswahl</h2>
          <p>Neuzugänge erscheinen hier, sobald sie geprüft und fotografiert sind.</p>
          <a class="sw-btn" href="{{ routes.all_products_collection_url }}">Alle Uhren ansehen</a>
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="sw-pagination" aria-label="Seiten">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">←</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">→</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Kollektion",
  "settings": []
}
{% endschema %}
