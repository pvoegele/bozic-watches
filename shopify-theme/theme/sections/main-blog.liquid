<section class="sw-sec">
  <div class="sw-wrap">
    <div class="sw-head">
      <h1 class="sw-h2">{{ blog.title }}</h1>
    </div>
    {%- paginate blog.articles by 12 -%}
      {%- for article in blog.articles -%}
        <article style="border-top: 1px solid var(--rule); padding: 1.5rem 0 2rem;">
          <span class="sw-label sw-label--red">{{ article.published_at | date: '%d.%m.%Y' }}</span>
          <h2 style="font-size: 1.375rem; font-weight: 800; letter-spacing: -0.02em; margin: 0.3rem 0 0.5rem;">
            <a href="{{ article.url }}" style="text-decoration: none;">{{ article.title }}</a>
          </h2>
          <p class="sw-lead" style="font-size: 0.9063rem;">{{ article.excerpt_or_content | strip_html | truncate: 180 }}</p>
        </article>
      {%- endfor -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
