{% comment %}
  BOZIC Watches – Konzept-Seite („Tresorraum bei Nacht“)
  Generiert aus shopify-theme/preview/konzept-preview.html – Änderungen
  dort vornehmen und build-liquid.py erneut ausführen.
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..800;1,6..96,400..800&family=Archivo:wght@300;400;500;600;700&display=swap">
<style>
/* ==========================================================================
   BOZIC Watches — Konzept · „Tresorraum bei Nacht"
   Vorschau der Shopify-Section sections/konzept.liquid
   ========================================================================== */

.bz {
  --vault: #0C0B09;          /* Raum nach Ladenschluss — warmes Schwarzbraun */
  --vault-deep: #100E0B;
  --panel: #16130E;          /* Vitrinenkorpus */
  --panel-lit: #1C1812;      /* angestrahlte Fläche */
  --brass: #C9A24B;          /* Messing */
  --brass-bright: #E9CE80;   /* Messingglanz im Licht */
  --brass-dim: #8A7439;
  --ivory: #F2EDE2;          /* warmes Licht auf Papier */
  --ivory-dim: #B3AA96;      /* Sekundärtext */
  --velvet: #10241C;         /* Vitrinensamt, dunkelgrün */
  --line-brass: rgba(201, 162, 75, 0.28);
  --line-faint: rgba(242, 237, 226, 0.10);

  --serif: "Bodoni Moda", "Bodoni MT", Didot, "Times New Roman", serif;
  --sans: "Archivo", "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;

  font-family: var(--sans);
  font-weight: 300;
  background: var(--vault);
  color: var(--ivory);
  line-height: 1.7;
  margin: 0;
  -webkit-font-smoothing: antialiased;
}

.bz *, .bz *::before, .bz *::after { box-sizing: border-box; }
.bz ::selection { background: var(--brass); color: var(--vault); }
.bz a { color: inherit; }
.bz :focus-visible { outline: 2px solid var(--brass); outline-offset: 4px; }

.bz-wrap { max-width: 76rem; margin: 0 auto; padding: 0 1.5rem; }
@media (min-width: 1024px) { .bz-wrap { padding: 0 2.5rem; } }

/* ---------- Typografie ---------- */

.bz h1, .bz h2, .bz h3 { margin: 0; text-wrap: balance; }

.bz-display {
  font-family: var(--serif);
  font-weight: 480;
  letter-spacing: 0.005em;
  line-height: 1.04;
}

.bz-h2 {
  font-family: var(--serif);
  font-weight: 480;
  font-size: clamp(2.1rem, 4.6vw, 3.4rem);
  line-height: 1.08;
  color: var(--ivory);
}
.bz-h2 .bz-no {
  font-family: var(--mono);
  font-size: 0.32em;
  font-weight: 400;
  color: var(--brass);
  letter-spacing: 0.28em;
  vertical-align: 0.9em;
  margin-right: 1.1em;
  font-variant-numeric: tabular-nums;
}

.bz-lead {
  font-size: 1.0313rem;
  color: var(--ivory-dim);
  max-width: 44rem;
  margin: 1.25rem 0 0;
}

.bz-head { margin-bottom: 3.25rem; }

.bz-cap {
  font-size: 0.6563rem;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  font-weight: 500;
  color: var(--brass);
}

.bz-mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }

/* ---------- Sektionen & Licht ---------- */

.bz-sec { position: relative; padding: 6.5rem 0; overflow: hidden; }
@media (max-width: 720px) { .bz-sec { padding: 4.25rem 0; } }

.bz-sec + .bz-sec { border-top: 1px solid var(--line-faint); }

/* Jede Sektion hat ihre eigene Lichtquelle */
.bz-sec::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(ellipse 55rem 30rem at 18% 0%, rgba(233, 206, 128, 0.055), transparent 62%);
}
.bz-sec--right::before {
  background: radial-gradient(ellipse 55rem 30rem at 85% 0%, rgba(233, 206, 128, 0.055), transparent 62%);
}
.bz-sec--center::before {
  background: radial-gradient(ellipse 60rem 26rem at 50% 0%, rgba(233, 206, 128, 0.05), transparent 65%);
}
.bz-sec > .bz-wrap { position: relative; }

/* ---------- Vitrinen-Panel ---------- */

.bz-case {
  background: linear-gradient(180deg, var(--panel-lit), var(--panel) 38%);
  border: 1px solid var(--line-faint);
  border-top-color: var(--line-brass);
  position: relative;
}
.bz-case::before {
  content: '';
  position: absolute;
  top: 0; left: 8%; right: 8%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(233, 206, 128, 0.55), transparent);
}

/* ---------- Hero ---------- */

.bz-hero {
  position: relative;
  min-height: 92vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 6rem 0 4rem;
  background: var(--vault);
}

.bz-hero-media {
  position: absolute;
  inset: 0;
  overflow: hidden;
}
.bz-hero-media video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.55;
}
/* Platzhalter-Szene: Lichtkegel + Staub — trägt den Hero auch ohne Video */
.bz-hero-media::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 46rem 34rem at 74% 44%, rgba(233, 206, 128, 0.12), transparent 58%),
    conic-gradient(from 152deg at 96% -14%, transparent 0deg, rgba(233, 206, 128, 0.10) 12deg, rgba(233, 206, 128, 0.02) 26deg, transparent 34deg),
    var(--vault);
}
/* Abdunklung zur Textseite + Boden */
.bz-hero-media::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(12, 11, 9, 0.94) 0%, rgba(12, 11, 9, 0.55) 46%, rgba(12, 11, 9, 0.15) 75%, rgba(12, 11, 9, 0.5) 100%),
    linear-gradient(0deg, rgba(12, 11, 9, 0.9) 0%, transparent 30%);
}

.bz-hero-grid {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  gap: 3rem;
  align-items: center;
  width: 100%;
}
@media (max-width: 900px) {
  .bz-hero-grid { grid-template-columns: 1fr; gap: 3.5rem; }
}

.bz-hero h1 {
  font-size: clamp(2.9rem, 7.2vw, 5.9rem);
  color: var(--ivory);
}
.bz-hero h1 em {
  font-style: italic;
  font-weight: 460;
  color: var(--brass-bright);
}

.bz-hero .bz-lead {
  font-size: clamp(1.0313rem, 1.6vw, 1.1875rem);
  max-width: 34rem;
  margin-top: 1.75rem;
}

.bz-hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.75rem;
  margin-top: 2.25rem;
  font-size: 0.6563rem;
  text-transform: uppercase;
  letter-spacing: 0.26em;
  font-weight: 500;
  color: var(--ivory-dim);
}
.bz-hero-meta strong { color: var(--brass); font-weight: 500; }

/* Exponat: Gravur-Uhr im Lichtkegel (Platzhalter für das Hero-Video) */
.bz-exhibit {
  position: relative;
  display: grid;
  place-items: center;
  padding: 1rem 0 2.5rem;
}
.bz-exhibit svg {
  width: min(21rem, 72vw);
  height: auto;
  display: block;
  filter: drop-shadow(0 18px 42px rgba(0, 0, 0, 0.55));
}
.bz-exhibit figcaption {
  margin-top: 1.6rem;
  font-size: 0.625rem;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  color: var(--ivory-dim);
  text-align: center;
  white-space: nowrap;
}
.bz-exhibit figcaption b { color: var(--brass); font-weight: 500; }
/* Podestlinie unter dem Exponat */
.bz-exhibit figcaption::before {
  content: '';
  display: block;
  width: 15rem;
  max-width: 60vw;
  height: 1px;
  margin: 0 auto 1.1rem;
  background: linear-gradient(90deg, transparent, var(--line-brass), transparent);
}

.bz-hero-nav {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-top: 3.25rem;
  padding-top: 2.25rem;
  border-top: 1px solid var(--line-faint);
}
.bz-hero-nav a {
  padding: 0.55rem 0.95rem;
  border: 1px solid var(--line-brass);
  text-decoration: none;
  font-size: 0.625rem;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-weight: 500;
  color: var(--ivory);
  transition: background 0.4s ease, color 0.4s ease, border-color 0.4s ease;
}
.bz-hero-nav a .bz-mono { color: var(--brass); margin-right: 0.5em; font-size: 0.9em; }
.bz-hero-nav a:hover { background: var(--brass); color: var(--vault); border-color: var(--brass); }
.bz-hero-nav a:hover .bz-mono { color: var(--vault); }

/* ---------- 01 Standbeine ---------- */

.bz-pillars {
  display: grid;
  grid-template-columns: 1fr 1.15fr 1fr;
  gap: 1.25rem;
  align-items: stretch;
}
@media (max-width: 900px) { .bz-pillars { grid-template-columns: 1fr; } }

.bz-pillar { padding: 2.25rem 2rem 2rem; display: flex; flex-direction: column; }
.bz-pillar--lead { background: linear-gradient(180deg, #211B12, var(--panel) 55%); }

.bz-pillar h3 {
  font-family: var(--serif);
  font-weight: 500;
  font-size: 1.5rem;
  color: var(--ivory);
  padding-bottom: 1rem;
  margin-bottom: 1.1rem;
  border-bottom: 1px solid var(--line-brass);
}
.bz-pillar p { margin: 0; font-size: 0.9375rem; color: var(--ivory-dim); }
.bz-pillar-fact {
  margin-top: auto;
  padding-top: 1.4rem;
  font-size: 0.625rem;
  text-transform: uppercase;
  letter-spacing: 0.24em;
  font-weight: 600;
  color: var(--brass);
}

/* ---------- Verkaufswege: Preisskala ---------- */

.bz-scale { margin-top: 1rem; }
.bz-scale-bar {
  position: relative;
  height: 1px;
  background: linear-gradient(90deg, var(--brass-dim), var(--brass), var(--brass-bright));
  margin: 3.25rem 0 0;
}
.bz-scale-bar i {
  position: absolute;
  top: 50%;
  width: 1px;
  height: 0.85rem;
  transform: translateY(-50%);
  background: var(--brass);
}
.bz-scale-bar i:nth-child(1) { left: 33.3%; }
.bz-scale-bar i:nth-child(2) { left: 66.6%; }

.bz-modes {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
  margin-top: 1.9rem;
}
@media (max-width: 860px) {
  .bz-scale-bar { display: none; }
  .bz-modes { grid-template-columns: 1fr; gap: 0; border-left: 1px solid var(--line-brass); }
  .bz-modes > div { padding: 1.5rem 0 1.5rem 1.75rem; }
  .bz-modes > div + div { border-top: 1px solid var(--line-faint); }
}

.bz-mode .bz-price {
  font-family: var(--serif);
  font-size: 1.6rem;
  font-weight: 500;
  color: var(--brass-bright);
  font-variant-numeric: tabular-nums;
  display: block;
}
.bz-mode h3 {
  font-size: 0.9688rem;
  font-weight: 600;
  font-family: var(--sans);
  color: var(--ivory);
  margin: 0.5rem 0 0.45rem;
}
.bz-mode p { margin: 0; font-size: 0.875rem; color: var(--ivory-dim); }

.bz-note {
  margin-top: 2.75rem;
  font-size: 0.8125rem;
  color: var(--ivory-dim);
}
.bz-note code {
  font-family: var(--mono);
  font-size: 0.85em;
  color: var(--brass);
  border: 1px solid var(--line-brass);
  padding: 0.1em 0.45em;
}

/* ---------- 02 Architektur ---------- */

.bz-arch { display: flex; flex-direction: column; }
.bz-arch-row { display: grid; gap: 1.1rem; }
.bz-arch-row--2 { grid-template-columns: 1fr 1fr; }
.bz-arch-row--3 { grid-template-columns: repeat(3, 1fr); }
@media (max-width: 760px) { .bz-arch-row--2, .bz-arch-row--3 { grid-template-columns: 1fr; } }

.bz-node { padding: 1.5rem 1.6rem; }
.bz-node h3 {
  font-family: var(--serif);
  font-weight: 500;
  font-size: 1.1875rem;
  color: var(--ivory);
  margin-bottom: 0.35rem;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.8rem;
  flex-wrap: wrap;
}
.bz-node h3 .bz-cap { font-weight: 500; }
.bz-node p { margin: 0; font-size: 0.8438rem; color: var(--ivory-dim); }

.bz-node--hub {
  border: 1px solid var(--brass);
  box-shadow: inset 0 0 0 4px var(--vault), inset 0 0 0 5px var(--line-brass);
  background: linear-gradient(180deg, #221C12, var(--panel) 60%);
  padding: 1.9rem 2rem;
}

.bz-arch-joint {
  display: flex;
  justify-content: center;
  padding: 0.35rem 0;
  color: var(--brass);
}
.bz-arch-joint svg { width: 1rem; height: 1rem; }

.bz-arch-why {
  margin: 3.25rem 0 0;
  padding: 0;
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.25rem;
}
@media (max-width: 860px) { .bz-arch-why { grid-template-columns: 1fr; } }
.bz-arch-why li {
  border-top: 1px solid var(--line-brass);
  padding-top: 1rem;
  font-size: 0.875rem;
  color: var(--ivory-dim);
}
.bz-arch-why strong { display: block; color: var(--ivory); font-weight: 600; margin-bottom: 0.25rem; }

/* ---------- 03 Verwaltung ---------- */

.bz-rail {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  margin: 0 0 3.5rem;
  padding: 0;
  list-style: none;
  counter-reset: step;
}
.bz-rail li {
  counter-increment: step;
  position: relative;
  background: linear-gradient(180deg, var(--panel-lit), var(--panel));
  border: 1px solid var(--line-faint);
  border-top-color: var(--line-brass);
  padding: 0.7rem 1rem 0.6rem;
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  color: var(--ivory);
}
.bz-rail li::before {
  content: counter(step, decimal-leading-zero);
  display: block;
  font-family: var(--mono);
  font-size: 0.5938rem;
  color: var(--brass);
  letter-spacing: 0.18em;
  margin-bottom: 0.2rem;
  font-variant-numeric: tabular-nums;
}
.bz-rail li[data-live] { border-color: var(--brass); color: var(--brass-bright); }
.bz-rail li[data-live]::after {
  content: 'im Shop sichtbar';
  display: block;
  margin-top: 0.25rem;
  font-size: 0.5313rem;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-weight: 400;
  color: var(--brass);
  white-space: nowrap;
}

/* Orchestrierter Moment: Fächer leuchten nacheinander auf */
.bz-js .bz-rail[data-animate] li {
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1), transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}
.bz-js .bz-rail[data-animate].bz-in li { opacity: 1; transform: none; }

.bz-admin {
  display: grid;
  grid-template-columns: 1.1fr 1fr 1fr;
  gap: 2.75rem;
}
@media (max-width: 960px) { .bz-admin { grid-template-columns: 1fr; } }

.bz-admin h3 {
  font-family: var(--serif);
  font-weight: 500;
  font-size: 1.25rem;
  color: var(--ivory);
  padding-bottom: 0.8rem;
  border-bottom: 1px solid var(--line-brass);
  margin-bottom: 1.1rem;
}
.bz-admin p { margin: 0 0 1rem; font-size: 0.8438rem; color: var(--ivory-dim); }

.bz-fields { list-style: none; margin: 0; padding: 0; font-family: var(--mono); font-size: 0.7188rem; }
.bz-fields li {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.45rem 0;
  border-bottom: 1px solid var(--line-faint);
  color: var(--ivory);
}
.bz-fields li:last-child { border-bottom: none; }
.bz-fields .bz-tag {
  font-family: var(--sans);
  font-size: 0.5938rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--brass);
  white-space: nowrap;
  align-self: center;
}
.bz-fields .bz-tag--int { color: var(--ivory-dim); }

.bz-list { list-style: none; margin: 0; padding: 0; }
.bz-list li { padding: 0.55rem 0; border-bottom: 1px solid var(--line-faint); font-size: 0.8438rem; color: var(--ivory-dim); }
.bz-list li:last-child { border-bottom: none; }
.bz-list strong { color: var(--ivory); font-weight: 600; }

/* ---------- 04 Abrechnung ---------- */

.bz-billing {
  display: grid;
  grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  gap: 2.25rem;
  align-items: stretch;
}
@media (max-width: 960px) { .bz-billing { grid-template-columns: 1fr; } }

.bz-velvet {
  background:
    radial-gradient(ellipse 26rem 18rem at 28% 0%, rgba(233, 206, 128, 0.09), transparent 62%),
    var(--velvet);
  border: 1px solid var(--line-brass);
  box-shadow: inset 0 0 0 5px var(--velvet), inset 0 0 0 6px rgba(201, 162, 75, 0.35);
  padding: 2.6rem 2.4rem;
}
.bz-velvet .bz-law {
  font-family: var(--serif);
  font-size: clamp(2.1rem, 3.4vw, 2.8rem);
  font-weight: 500;
  color: var(--brass-bright);
  line-height: 1.05;
}
.bz-velvet h3 {
  font-family: var(--sans);
  font-size: 0.9688rem;
  font-weight: 600;
  color: var(--ivory);
  margin: 1rem 0 0.9rem;
}
.bz-velvet p { margin: 0 0 0.9rem; font-size: 0.875rem; color: rgba(242, 237, 226, 0.82); }
.bz-velvet p:last-child { margin: 0; }
.bz-velvet strong { color: var(--ivory); }

.bz-tablecase { overflow-x: auto; scrollbar-width: thin; scrollbar-color: var(--brass-dim) var(--panel); position: relative; }
.bz-tablescroll { position: relative; min-width: 0; }
@media (max-width: 760px) {
  .bz-tablescroll::after {
    content: '';
    position: absolute;
    top: 1px; right: 1px; bottom: 1px;
    width: 3.5rem;
    background: linear-gradient(90deg, transparent, rgba(10, 9, 7, 0.95));
    pointer-events: none;
  }
}
.bz-table { width: 100%; border-collapse: collapse; font-size: 0.8438rem; min-width: 30rem; }
.bz-table caption {
  text-align: left;
  padding: 1.4rem 1.6rem 0.9rem;
  font-size: 0.6563rem;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  font-weight: 500;
  color: var(--brass);
}
.bz-table th {
  text-align: left;
  font-size: 0.5938rem;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-weight: 600;
  color: var(--ivory-dim);
  padding: 0.7rem 1.6rem;
  border-top: 1px solid var(--line-brass);
  border-bottom: 1px solid var(--line-faint);
  white-space: nowrap;
}
.bz-table td {
  padding: 0.8rem 1.6rem;
  border-bottom: 1px solid var(--line-faint);
  color: var(--ivory);
  vertical-align: top;
}
.bz-table tr:last-child td { border-bottom: none; }
.bz-table .bz-dim { color: var(--ivory-dim); }
.bz-table .bz-right { text-align: right; font-family: var(--mono); font-size: 0.9em; white-space: nowrap; font-variant-numeric: tabular-nums; }
.bz-table tr.bz-sum td {
  border-top: 1px solid var(--line-brass);
  color: var(--brass-bright);
  font-weight: 600;
}
.bz-table tr.bz-sum .bz-right { font-weight: 400; }

.bz-flow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.65rem;
  margin-top: 2.5rem;
  font-size: 0.7813rem;
  color: var(--ivory-dim);
}
.bz-flow .bz-step {
  border: 1px solid var(--line-faint);
  border-top-color: var(--line-brass);
  background: var(--panel);
  color: var(--ivory);
  padding: 0.5rem 0.9rem;
  font-weight: 500;
}
.bz-flow svg { width: 0.85rem; height: 0.85rem; color: var(--brass); flex-shrink: 0; }

/* ---------- 05 Marketing ---------- */

.bz-chips { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 2.75rem; }
.bz-chips span {
  border: 1px solid var(--line-faint);
  padding: 0.5rem 0.9rem;
  font-size: 0.7188rem;
  font-weight: 500;
  color: var(--ivory-dim);
}
.bz-chips span b { color: var(--brass); font-weight: 500; }

.bz-channels { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
@media (max-width: 900px) { .bz-channels { grid-template-columns: 1fr; } }

.bz-channel { padding: 2.1rem 2rem; }
.bz-channel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  border-bottom: 1px solid var(--line-brass);
  padding-bottom: 1.1rem;
  margin-bottom: 0.4rem;
}
.bz-channel-head h3 {
  font-family: var(--serif);
  font-weight: 500;
  font-size: 1.5rem;
  color: var(--ivory);
}
.bz-channel-head .bz-budget {
  font-family: var(--mono);
  font-size: 0.75rem;
  color: var(--brass);
  font-variant-numeric: tabular-nums;
}
.bz-channel table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; }
.bz-channel td { padding: 0.6rem 0; border-bottom: 1px solid var(--line-faint); color: var(--ivory-dim); }
.bz-channel tr:last-child td { border-bottom: none; }
.bz-channel td:first-child { color: var(--ivory); padding-right: 1rem; }
.bz-channel td em { font-style: normal; color: var(--ivory-dim); }
.bz-channel td:last-child {
  text-align: right;
  font-family: var(--mono);
  font-size: 0.7188rem;
  color: var(--ivory-dim);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}
.bz-channel-note { margin: 1.2rem 0 0; font-size: 0.8125rem; color: var(--ivory-dim); }
.bz-channel-note strong { color: var(--brass); font-weight: 500; }

.bz-leadflow {
  margin-top: 1.5rem;
  padding: 1.4rem 2rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.7rem;
  font-size: 0.8125rem;
  color: var(--ivory-dim);
}
.bz-leadflow strong { color: var(--ivory); font-weight: 600; }
.bz-leadflow svg { width: 0.85rem; height: 0.85rem; color: var(--brass); flex-shrink: 0; }
.bz-leadflow .bz-sla {
  margin-left: auto;
  border: 1px solid var(--brass);
  color: var(--brass-bright);
  font-size: 0.5938rem;
  text-transform: uppercase;
  letter-spacing: 0.22em;
  font-weight: 600;
  padding: 0.5rem 0.85rem;
  white-space: nowrap;
}
@media (max-width: 720px) { .bz-leadflow .bz-sla { margin-left: 0; } }

/* ---------- 06 Roadmap ---------- */

.bz-phases { position: relative; margin-left: 0.4rem; }
.bz-phases::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.6rem;
  bottom: 0.6rem;
  width: 1px;
  background: linear-gradient(180deg, var(--brass), var(--line-brass));
}

.bz-phase {
  position: relative;
  padding: 0 0 3.25rem 2.75rem;
}
.bz-phase:last-child { padding-bottom: 0.5rem; }
.bz-phase::before {
  content: '';
  position: absolute;
  left: -0.3rem;
  top: 0.55rem;
  width: 0.65rem;
  height: 0.65rem;
  background: var(--vault);
  border: 1px solid var(--brass);
  transform: rotate(45deg);
}

.bz-phase-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.4rem 1.4rem;
  margin-bottom: 0.5rem;
}
.bz-phase-head h3 {
  font-family: var(--serif);
  font-weight: 500;
  font-size: 1.5625rem;
  color: var(--ivory);
}
.bz-phase-head .bz-when {
  font-family: var(--mono);
  font-size: 0.6563rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--brass);
  font-variant-numeric: tabular-nums;
}
.bz-phase .bz-goal { margin: 0 0 1.1rem; font-size: 0.875rem; color: var(--ivory-dim); }
.bz-phase ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.45rem 2.75rem;
  max-width: 52rem;
}
@media (max-width: 820px) { .bz-phase ul { grid-template-columns: 1fr; } }
.bz-phase li {
  position: relative;
  padding-left: 1.15rem;
  font-size: 0.8438rem;
  color: var(--ivory);
  font-weight: 400;
}
.bz-phase li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.65em;
  width: 0.5rem;
  height: 1px;
  background: var(--brass);
}

/* ---------- 07 Kosten ---------- */

.bz-costwrap { max-width: 46rem; }

/* ---------- 08 Entscheidungen ---------- */

.bz-decisions {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  counter-reset: dec;
  border-top: 1px solid var(--line-faint);
}
@media (max-width: 860px) { .bz-decisions { grid-template-columns: 1fr; } }
.bz-decisions li {
  counter-increment: dec;
  display: grid;
  grid-template-columns: 2.6rem 1fr;
  gap: 1rem;
  padding: 1.5rem 2rem 1.5rem 0;
  border-bottom: 1px solid var(--line-faint);
}
@media (min-width: 861px) {
  .bz-decisions li:nth-child(odd) { border-right: 1px solid var(--line-faint); }
  .bz-decisions li:nth-child(even) { padding-left: 2rem; padding-right: 0; }
}
.bz-decisions li::before {
  content: counter(dec, decimal-leading-zero);
  font-family: var(--mono);
  font-size: 0.8125rem;
  color: var(--brass);
  padding-top: 0.15rem;
  font-variant-numeric: tabular-nums;
}
.bz-decisions h3 { font-size: 0.9375rem; font-weight: 600; color: var(--ivory); margin-bottom: 0.25rem; }
.bz-decisions p { margin: 0; font-size: 0.8125rem; color: var(--ivory-dim); }
.bz-decisions p strong { color: rgba(242, 237, 226, 0.92); font-weight: 500; }

/* ---------- CTA & Footer ---------- */

.bz-cta { margin-top: 4.5rem; text-align: center; }
.bz-cta p {
  font-family: var(--serif);
  font-size: clamp(1.25rem, 2.4vw, 1.7rem);
  font-weight: 460;
  color: var(--ivory);
  max-width: 34em;
  margin: 0 auto 2.25rem;
  line-height: 1.4;
  text-wrap: balance;
}
.bz-cta p em { font-style: italic; color: var(--brass-bright); }
.bz-btns { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
.bz-btn {
  display: inline-block;
  padding: 1rem 2.6rem;
  border: 1px solid var(--brass);
  color: var(--brass-bright);
  text-decoration: none;
  font-size: 0.6875rem;
  text-transform: uppercase;
  letter-spacing: 0.26em;
  font-weight: 600;
  transition: background 0.45s ease, color 0.45s ease;
}
.bz-btn:hover { background: var(--brass); color: var(--vault); }
.bz-btn--ghost { border-color: var(--line-faint); color: var(--ivory-dim); }
.bz-btn--ghost:hover { background: transparent; border-color: var(--brass); color: var(--brass-bright); }

.bz-foot {
  margin-top: 5.5rem;
  padding-top: 1.75rem;
  border-top: 1px solid var(--line-faint);
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 2rem;
  justify-content: space-between;
  font-size: 0.5938rem;
  text-transform: uppercase;
  letter-spacing: 0.26em;
  font-weight: 500;
  color: var(--ivory-dim);
}

/* ---------- Reveals (Default sichtbar, nur mit JS animiert) ---------- */

/* Ein Motion-Moment (Pipeline-Stagger); nur Kapitelkoepfe blenden zusaetzlich ein */
.bz-js .bz-head.bz-r {
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
}
.bz-js .bz-head.bz-r.bz-in { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce) {
  .bz-js .bz-head.bz-r, .bz-js .bz-rail[data-animate] li { opacity: 1; transform: none; transition: none; }
}

html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
body { margin: 0; background: #0C0B09; scrollbar-color: #8A7439 #0C0B09; }
body::-webkit-scrollbar { width: 9px; }
body::-webkit-scrollbar-track { background: #0C0B09; }
body::-webkit-scrollbar-thumb { background: #8A7439; border-radius: 0; }
</style>

